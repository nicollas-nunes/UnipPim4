# Copie para .env e preencha. O .env NUNCA vai para o Git.
PORT=3000

# Conexão com o SQL Server (mesmo banco do HytechAdmin-WinForms)
DB_SERVER=localhost
DB_NAME=HytechDB
DB_USER=sa
DB_PASSWORD=troque-esta-senha
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT: texto aleatório com no mínimo 32 caracteres
JWT_KEY=troque-por-um-texto-aleatorio-bem-longo-123456
JWT_ISSUER=HytechApi
JWT_AUDIENCE=HytechWeb
JWT_EXPIRA_MINUTOS=120

# Endereços de onde o index.html é aberto (separados por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Máximo de tickets/mensagens por usuário por hora (padrão 60)
#TICKETS_LIMITE_POR_HORA=60

# ── PUBLICAÇÃO (Fase 6) ──
# NODE_ENV=production   (liga: validação do .env, log de requisições, cache do site)
# TRUST_PROXY=1         (use 1 se a API ficar atrás de Nginx/IIS/Cloudflare; senão deixe vazio)
# SERVIR_SITE=true      (a própria API entrega o site da pasta web/: um só endereço, sem CORS)
# LIMITE_GERAL_POR_MINUTO=300
# LIMITE_CONTEUDO_POR_HORA=120
# LOG_REQUISICOES=true
