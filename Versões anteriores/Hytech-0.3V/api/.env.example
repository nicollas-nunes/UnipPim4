# Copie para .env e preencha. O .env NUNCA vai para o Git.
PORT=3000

# Conexão com o SQL Server (mesmo banco do HytechAdmin-WinForms)
DB_SERVER=localhost
DB_NAME=HytechDB
DB_USER=sa
DB_PASSWORD=troque-esta-senha
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT: texto aleatório com no mínimo 32 caracteres
JWT_KEY=troque-por-um-texto-aleatorio-bem-longo-123456
JWT_ISSUER=HytechApi
JWT_AUDIENCE=HytechWeb
JWT_EXPIRA_MINUTOS=120

# Endereços de onde o index.html é aberto (separados por vírgula)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
