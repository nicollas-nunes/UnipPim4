-- 2.11 Loga ativação/inativação de usuário (tela de gerenciar usuários do admin)
CREATE OR ALTER TRIGGER TR_Usuario_LogStatus
ON Usuario
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;
    IF UPDATE(status)
    BEGIN
        INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
        SELECT I.id_usuario,
               'USUÁRIO ' + CASE WHEN I.status = 'ativo' THEN 'ATIVADO' ELSE 'INATIVADO' END + ': ' + I.nome,
               GETDATE()
        FROM inserted I
        INNER JOIN deleted D ON D.id_usuario = I.id_usuario
        WHERE I.status <> D.status;
    END
END
