-- 3.1 Aluno responde uma questão: valida alternativa, grava e devolve se acertou
CREATE OR ALTER PROCEDURE sp_ResponderQuestao
    @id_aluno       INT,
    @id_questao     INT,
    @id_alternativa INT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @acertou BIT;

    SELECT @acertou = correta FROM Alternativa
    WHERE id_alternativa = @id_alternativa AND id_questao = @id_questao;

    IF @acertou IS NULL
    BEGIN
        RAISERROR('Alternativa não pertence a essa questão.', 16, 1);
        RETURN;
    END

    IF EXISTS (SELECT 1 FROM Aluno_Questao WHERE id_aluno = @id_aluno AND id_questao = @id_questao)
        UPDATE Aluno_Questao
        SET concluida = @acertou, data_conclusao = GETDATE()
        WHERE id_aluno = @id_aluno AND id_questao = @id_questao;
    ELSE
        INSERT INTO Aluno_Questao (id_aluno, id_questao, concluida, data_conclusao)
        VALUES (@id_aluno, @id_questao, @acertou, GETDATE());

    SELECT @acertou AS acertou;
END
GO

-- 3.2 Marca uma aula como concluída pelo aluno
CREATE OR ALTER PROCEDURE sp_ConcluirAula
    @id_aluno INT,
    @id_aula  INT
AS
