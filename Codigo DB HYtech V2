-- 3.6 Atualiza o streak do aluno com base na última atividade registrada em LogAtividade
CREATE OR ALTER PROCEDURE sp_AtualizarStreak
    @id_aluno INT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @id_usuario INT, @ultima_atividade DATE, @hoje DATE = CAST(GETDATE() AS DATE);

    SELECT @id_usuario = id_usuario FROM Aluno WHERE id_aluno = @id_aluno;

    SELECT @ultima_atividade = MAX(CAST(data_hora AS DATE))
    FROM LogAtividade
    WHERE id_usuario = @id_usuario AND CAST(data_hora AS DATE) < @hoje;

    UPDATE Aluno
    SET streak_atual = CASE
                            WHEN @ultima_atividade = DATEADD(DAY, -1, @hoje) THEN streak_atual + 1
                            WHEN @ultima_atividade IS NULL THEN 1
                            ELSE 1
                        END
    WHERE id_aluno = @id_aluno;
END
GO

-- 3.7 Ranking dos N alunos com mais pontos — agora também retorna fases_concluidas
--     (aulas + questões concluídas), usado no painel lateral e na tela de ranking
CREATE OR ALTER PROCEDURE sp_RankingAlunos
    @top INT = 10
AS
BEGIN
    SET NOCOUNT ON;
    SELECT TOP (@top)
           U.nome, U.nickname, A.pontos_acumulados, A.streak_atual,
           ISNULL(AA.fases_aula, 0) + ISNULL(AQ.fases_questao, 0) AS fases_concluidas
    FROM Aluno A
    INNER JOIN Usuario U ON U.id_usuario = A.id_usuario
    OUTER APPLY (SELECT COUNT(*) AS fases_aula FROM Aluno_Aula x
                 WHERE x.id_aluno = A.id_aluno AND x.progresso_concluido = 1) AA
    OUTER APPLY (SELECT COUNT(*) AS fases_questao FROM Aluno_Questao y
                 WHERE y.id_aluno = A.id_aluno AND y.concluida = 1) AQ
    ORDER BY A.pontos_acumulados DESC;
END
GO

-- 3.8 Progresso consolidado de um aluno em uma trilha (usado na tela "Trilha")
CREATE OR ALTER PROCEDURE sp_ProgressoTrilhaAluno
    @id_aluno  INT,
    @id_trilha INT
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @total_aulas INT, @aulas_concluidas INT,
            @total_questoes INT, @questoes_concluidas INT;

    SELECT @total_aulas = COUNT(*) FROM Aula Au
    INNER JOIN Materia M ON M.id_materia = Au.id_materia
    WHERE M.id_trilha = @id_trilha;

    SELECT @aulas_concluidas = COUNT(*) FROM Aluno_Aula AA
    INNER JOIN Aula Au ON Au.id_aula = AA.id_aula
    INNER JOIN Materia M ON M.id_materia = Au.id_materia
    WHERE M.id_trilha = @id_trilha AND AA.id_aluno = @id_aluno AND AA.progresso_concluido = 1;

    SELECT @total_questoes = COUNT(*) FROM Questao Q
    INNER JOIN Materia M ON M.id_materia = Q.id_materia
    WHERE M.id_trilha = @id_trilha;

    SELECT @questoes_concluidas = COUNT(*) FROM Aluno_Questao AQ
    INNER JOIN Questao Q ON Q.id_questao = AQ.id_questao
    INNER JOIN Materia M ON M.id_materia = Q.id_materia
    WHERE M.id_trilha = @id_trilha AND AQ.id_aluno = @id_aluno AND AQ.concluida = 1;

    SELECT
        @total_aulas AS total_aulas, @aulas_concluidas AS aulas_concluidas,
        @total_questoes AS total_questoes, @questoes_concluidas AS questoes_concluidas,
        CASE WHEN (@total_aulas + @total_questoes) = 0 THEN 0
             ELSE CAST((@aulas_concluidas + @questoes_concluidas) AS DECIMAL(5,2))
                  / (@total_aulas + @total_questoes) * 100
        END AS percentual_progresso;

    -- também mantém a tabela Aluno_Trilha sincronizada
    UPDATE Aluno_Trilha
    SET progresso = CASE WHEN (@total_aulas + @total_questoes) = 0 THEN 0
                          ELSE CAST((@aulas_concluidas + @questoes_concluidas) AS DECIMAL(5,2))
                               / (@total_aulas + @total_questoes) * 100 END
    WHERE id_aluno = @id_aluno AND id_trilha = @id_trilha;
END
GO

