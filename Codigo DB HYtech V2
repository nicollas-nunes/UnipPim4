    IF EXISTS (SELECT 1 FROM Aluno_Aula WHERE id_aluno = @id_aluno AND id_aula = @id_aula)
        UPDATE Aluno_Aula SET progresso_concluido = 1 WHERE id_aluno = @id_aluno AND id_aula = @id_aula;
    ELSE
        INSERT INTO Aluno_Aula (id_aluno, id_aula, progresso_concluido)
        VALUES (@id_aluno, @id_aula, 1);
END
