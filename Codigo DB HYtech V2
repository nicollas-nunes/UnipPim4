-- ============================================================
-- HytechDB — SCRIPT COMPLETO (v2)
-- Schema + ajustes de compatibilidade com a interface, já
-- incorporados nas colunas das tabelas (sem ALTER) + Triggers
-- + Stored Procedures
--
-- Novidades desta versão (a partir da comparação com o front):
--   • Usuario.status        -> ativar/inativar usuário (tela admin)
--   • Usuario.foto_url      -> avatar de perfil (aluno/professor)
--   • TicketSuporte.id_materia -> matéria associada ao ticket
--   • Desafio.data_criacao  -> data usada na listagem de desafios
--   • Triggers de desafio/certificado agora leem os valores de
--     recompensa em ChavesConfig (em vez de valor fixo no código)
--   • LogAtividade agora é alimentado também por: cadastro de
--     aluno/professor, login, aprovação/rejeição de questão,
--     emissão de certificado (com crédito de chaves) e alteração
--     de configuração da plataforma / status de usuário
--   • sp_RankingAlunos agora retorna também "fases_concluidas"
-- ============================================================

CREATE DATABASE HytechDB
GO

USE HytechDB
GO

-- ============================================================
-- 1. Entidades base
-- ============================================================

-- Usuario: já com status (ativo/inativo) e foto de perfil
CREATE TABLE Usuario (
    id_usuario      INT IDENTITY(1,1) PRIMARY KEY,
    nome            VARCHAR(100),
    nickname        VARCHAR(50) UNIQUE,
    email           VARCHAR(100) UNIQUE,
    senha           VARCHAR(255),
    data_nascimento DATE,
    status          VARCHAR(20)  NOT NULL DEFAULT 'ativo',   -- 'ativo' | 'inativo'
    foto_url        VARCHAR(255) NULL
);
GO

CREATE TABLE SistemaMetricas (
    id_metrica          INT IDENTITY(1,1) PRIMARY KEY,
    data                DATE,
    total_usuarios      INT,
    media_engajamento   DECIMAL(5,2),
    taxa_conversao      DECIMAL(5,2)
);
GO

CREATE TABLE TrilhaAprendizagem (
    id_trilha   INT IDENTITY(1,1) PRIMARY KEY,
    nome_trilha VARCHAR(100),
    descricao   VARCHAR(MAX)
);
GO

-- ============================================================
-- 2. Entidades que dependem de Usuario
-- ============================================================

CREATE TABLE Professor (
