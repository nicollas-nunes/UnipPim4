-- ============================================================
-- PARTE 2 — TRIGGERS
-- ============================================================

-- 2.1 Ao aluno concluir uma questão corretamente, credita as chaves na conta dele
CREATE OR ALTER TRIGGER TR_AlunoQuestao_CreditaChaves
ON Aluno_Questao
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE A
    SET A.pontos_acumulados = A.pontos_acumulados + Q.chaves_recompensa
    FROM Aluno A
    INNER JOIN inserted I  ON I.id_aluno = A.id_aluno
    INNER JOIN Questao Q   ON Q.id_questao = I.id_questao
    LEFT JOIN deleted D    ON D.id_Alu_Que = I.id_Alu_Que
    WHERE I.concluida = 1
      AND (D.id_Alu_Que IS NULL OR D.concluida = 0);   -- só credita na transição p/ concluída

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           'Questão ' + CAST(I.id_questao AS VARCHAR) + ' concluída (+' + CAST(Q.chaves_recompensa AS VARCHAR) + ' chaves)',
           GETDATE()
    FROM inserted I
    INNER JOIN Aluno A   ON A.id_aluno = I.id_aluno
    INNER JOIN Usuario U ON U.id_usuario = A.id_usuario
    INNER JOIN Questao Q ON Q.id_questao = I.id_questao
    LEFT JOIN deleted D  ON D.id_Alu_Que = I.id_Alu_Que
    WHERE I.concluida = 1
      AND (D.id_Alu_Que IS NULL OR D.concluida = 0);
END
GO

-- 2.2 Ao aluno concluir um desafio, credita pontos por dificuldade (lendo de
--     ChavesConfig, o mesmo valor editável na tela de configuração do admin) e loga
CREATE OR ALTER TRIGGER TR_AlunoDesafio_CreditaChaves
ON Aluno_Desafio
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @facil INT, @media INT, @dificil INT;
    SELECT TOP 1 @facil = chaves_questao_facil,
                 @media = chaves_questao_media,
                 @dificil = chaves_questao_dificil
    FROM ChavesConfig;
    SET @facil   = ISNULL(@facil, 5);
    SET @media   = ISNULL(@media, 10);
    SET @dificil = ISNULL(@dificil, 15);

    UPDATE A
    SET A.pontos_acumulados = A.pontos_acumulados +
        CASE Dsf.dificuldade
            WHEN 'Fácil'   THEN @facil
            WHEN 'Médio'   THEN @media
            WHEN 'Difícil' THEN @dificil
            ELSE @facil
        END
    FROM Aluno A
    INNER JOIN inserted I  ON I.id_aluno = A.id_aluno
    INNER JOIN Desafio Dsf ON Dsf.id_desafio = I.id_desafio
    LEFT JOIN deleted D    ON D.id_Alu_Des = I.id_Alu_Des
    WHERE I.concluido = 1
      AND (D.id_Alu_Des IS NULL OR D.concluido = 0);

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           'Desafio ' + CAST(I.id_desafio AS VARCHAR) + ' concluído (' + Dsf.dificuldade + ')',
           GETDATE()
    FROM inserted I
    INNER JOIN Aluno A    ON A.id_aluno = I.id_aluno
    INNER JOIN Usuario U  ON U.id_usuario = A.id_usuario
    INNER JOIN Desafio Dsf ON Dsf.id_desafio = I.id_desafio
    LEFT JOIN deleted D   ON D.id_Alu_Des = I.id_Alu_Des
    WHERE I.concluido = 1
      AND (D.id_Alu_Des IS NULL OR D.concluido = 0);
END
GO

-- 2.3 Ao professor cadastrar uma questão pendente, gera automaticamente o item
--     na fila de aprovação e loga o envio
CREATE OR ALTER TRIGGER TR_Questao_GeraAprovacao
ON Questao
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO Aprovacao (tipo, id_questao, id_professor, status, data_submissao)
    SELECT 'questao', I.id_questao, I.id_professor, 'pendente', ISNULL(I.data_criacao, GETDATE())
    FROM inserted I
    WHERE I.status_aprovacao = 'pendente';

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           'CONTEÚDO ENVIADO (questão): ' + LEFT(ISNULL(I.enunciado, ''), 60),
           GETDATE()
    FROM inserted I
    INNER JOIN Professor P ON P.id_professor = I.id_professor
    INNER JOIN Usuario U   ON U.id_usuario = P.id_usuario
    WHERE I.status_aprovacao = 'pendente';
END
GO

-- 2.4 Mesmo comportamento para novas aulas
CREATE OR ALTER TRIGGER TR_Aula_GeraAprovacao
ON Aula
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;
    INSERT INTO Aprovacao (tipo, id_aula, id_professor, status, data_submissao)
    SELECT 'aula', I.id_aula, M.id_professor, 'pendente', GETDATE()
    FROM inserted I
    INNER JOIN Materia M ON M.id_materia = I.id_materia;

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           'CONTEÚDO ENVIADO (aula): ' + LEFT(ISNULL(I.titulo, ''), 60),
           GETDATE()
    FROM inserted I
    INNER JOIN Materia M   ON M.id_materia = I.id_materia
    INNER JOIN Professor P ON P.id_professor = M.id_professor
    INNER JOIN Usuario U   ON U.id_usuario = P.id_usuario;
END
GO

-- 2.5 Quando o admin muda o status de uma Aprovacao, reflete o status na
--     Questao de origem e loga a aprovação/rejeição
CREATE OR ALTER TRIGGER TR_Aprovacao_SincronizaStatus
ON Aprovacao
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE Q SET Q.status_aprovacao = I.status
    FROM Questao Q
    INNER JOIN inserted I ON I.id_questao = Q.id_questao
    WHERE I.tipo = 'questao';

    -- Aula não tem coluna de status próprio no schema original;
    -- se desejar refletir lá também, adicionar status_aprovacao em Aula.

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           CASE WHEN I.status = 'aprovado' THEN 'QUESTÃO APROVADA: #' ELSE 'QUESTÃO REJEITADA: #' END
               + CAST(I.id_questao AS VARCHAR),
           GETDATE()
    FROM inserted I
    INNER JOIN deleted D    ON D.id_aprovacao = I.id_aprovacao
    INNER JOIN Questao Q    ON Q.id_questao = I.id_questao
    INNER JOIN Professor P  ON P.id_professor = Q.id_professor
    INNER JOIN Usuario U    ON U.id_usuario = P.id_usuario
    WHERE I.tipo = 'questao'
      AND I.status <> D.status
      AND I.status IN ('aprovado', 'rejeitado');
END
GO

-- 2.6 Nova mensagem de professor/admin no ticket muda o status para 'respondido';
--     nova mensagem do próprio solicitante reabre o ticket
CREATE OR ALTER TRIGGER TR_TicketMensagem_AtualizaStatus
ON TicketMensagem
AFTER INSERT
AS
BEGIN
    SET NOCOUNT ON;

    UPDATE T
    SET T.status = CASE WHEN I.id_usuario_remetente = T.id_usuario_solicitante
                         THEN 'aberto' ELSE 'respondido' END
    FROM TicketSuporte T
    INNER JOIN inserted I ON I.id_ticket = T.id_ticket;
END
GO

-- 2.7 Emite certificado automaticamente quando o aluno concluiu todas as aulas
--     e todas as questões de uma matéria — credita chaves_certificado (via
--     ChavesConfig) e loga a emissão
CREATE OR ALTER TRIGGER TR_AlunoAula_EmiteCertificado
ON Aluno_Aula
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    DECLARE @chaves_certificado INT;
    SELECT TOP 1 @chaves_certificado = chaves_certificado FROM ChavesConfig;
    SET @chaves_certificado = ISNULL(@chaves_certificado, 50);

    DECLARE @NovosCertificados TABLE (id_aluno INT, id_materia INT);

    ;WITH MateriasAfetadas AS (
        SELECT DISTINCT I.id_aluno, Au.id_materia
        FROM inserted I
        INNER JOIN Aula Au ON Au.id_aula = I.id_aula
        WHERE I.progresso_concluido = 1
    )
    INSERT INTO Certificado (id_aluno, id_materia, data_emissao)
    OUTPUT inserted.id_aluno, inserted.id_materia INTO @NovosCertificados
    SELECT MA.id_aluno, MA.id_materia, GETDATE()
    FROM MateriasAfetadas MA
    WHERE NOT EXISTS (
              SELECT 1 FROM Certificado C
              WHERE C.id_aluno = MA.id_aluno AND C.id_materia = MA.id_materia)
      -- todas as aulas da matéria concluídas
      AND NOT EXISTS (
              SELECT 1 FROM Aula Au2
              LEFT JOIN Aluno_Aula AA2
                     ON AA2.id_aula = Au2.id_aula AND AA2.id_aluno = MA.id_aluno AND AA2.progresso_concluido = 1
              WHERE Au2.id_materia = MA.id_materia AND AA2.id_Alu_Aula IS NULL)
      -- todas as questões da matéria concluídas
      AND NOT EXISTS (
              SELECT 1 FROM Questao Q2
              LEFT JOIN Aluno_Questao AQ2
                     ON AQ2.id_questao = Q2.id_questao AND AQ2.id_aluno = MA.id_aluno AND AQ2.concluida = 1
              WHERE Q2.id_materia = MA.id_materia AND AQ2.id_Alu_Que IS NULL);

    -- credita as chaves do certificado para quem acabou de recebê-lo
    UPDATE A
    SET A.pontos_acumulados = A.pontos_acumulados + @chaves_certificado
    FROM Aluno A
    INNER JOIN @NovosCertificados NC ON NC.id_aluno = A.id_aluno;

    INSERT INTO LogAtividade (id_usuario, descricao, data_hora)
    SELECT U.id_usuario,
           'CERTIFICADO EMITIDO: matéria #' + CAST(NC.id_materia AS VARCHAR) + ' (+' + CAST(@chaves_certificado AS VARCHAR) + ' chaves)',
           GETDATE()
    FROM @NovosCertificados NC
    INNER JOIN Aluno A   ON A.id_aluno = NC.id_aluno
    INNER JOIN Usuario U ON U.id_usuario = A.id_usuario;
END
GO

-- 2.8 Impede excluir uma Materia que já possua Aulas ou Questões vinculadas
--     (proteção extra além do FK, com mensagem amigável)
CREATE OR ALTER TRIGGER TR_Materia_ImpedeExclusao
ON Materia
INSTEAD OF DELETE
AS
BEGIN
    SET NOCOUNT ON;
    IF EXISTS (SELECT 1 FROM deleted D
               WHERE EXISTS (SELECT 1 FROM Aula A WHERE A.id_materia = D.id_materia)
                  OR EXISTS (SELECT 1 FROM Questao Q WHERE Q.id_materia = D.id_materia))
    BEGIN
        RAISERROR('Não é possível excluir uma matéria com aulas ou questões vinculadas.', 16, 1);
        RETURN;
    END
    DELETE FROM Materia WHERE id_materia IN (SELECT id_materia FROM deleted);
END
GO

